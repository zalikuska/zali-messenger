# ================================================================
# ZaliMessenger Server — Конфигурация окружения
# Скопируйте в .env и заполните перед запуском в продакшене
# ================================================================

# ОБЯЗАТЕЛЬНО в продакшене: секретный ключ для подписи JWT-токенов.
# Должен быть не менее 32 символов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_ZALI_SECRET_KEY_MIN32CH

# Разрешённые CORS-источники (через запятую).
# В продакшене укажите только ваши домены — этот список работает вместе с
# allow_credentials(true), то есть каждый источник отсюда может ходить в API
# с cookie пользователя и читать ответы.
#
# НЕ добавляйте сюда `null`: это origin песочничного iframe, `data:`- и
# `file:`-документов, то есть ровно того, что подставляет чужая страница.
# Раньше он стоял в этом примере; сервер теперь выбрасывает его сам и пишет
# предупреждение в лог, но и в конфиге ему не место.
#
# localhost-источники нужны только для локальной разработки — в проде они
# означают, что любая страница, отданная с localhost:80/3000 (чужой dev-сервер,
# локально запущенный зловред), получает полный доступ к API от имени
# залогиненного пользователя.
ALLOWED_ORIGINS=https://msgs.zalikus.org,zali://localhost

# Максимальный размер загружаемого файла в байтах (по умолчанию 10MB).
MAX_UPLOAD_BYTES=10485760

# Гостевой режим: КАЖДЫЙ запрос без токена выполняется от имени пользователя
# "Zalikus". Это не «упрощённый вход», а полное отключение аутентификации:
# читать переписку, отправлять сообщения и менять настройки этого аккаунта
# сможет кто угодно, кто знает адрес сервера.
#
# Оставлено только для локальной отладки старых сборок. В любом развёрнутом
# сервере — false. Раньше здесь по умолчанию стояло true, то есть скопированный
# как есть пример открывал аккаунт наружу; сервер теперь пишет в лог отдельное
# предупреждение при каждом старте с включённым режимом.
ALLOW_GUEST_MODE=false

# Rate limiting для /api/auth/login — два независимых бюджета.
#
# RATE_LIMIT_MAX_ATTEMPTS — попыток на пару (логин, IP) за окно. Тормозит подбор
# пароля к одному аккаунту.
#
# RATE_LIMIT_MAX_FAILED_PER_IP — НЕУДАЧНЫХ входов с одного IP за окно, по всем
# логинам сразу. Без него подбор одного пароля по списку логинов (password spray)
# не ограничен ничем: каждая попытка попадает в свой бюджет по первому ключу, а
# список аккаунтов и так отдаётся любому залогиненному через /api/users.
# Считаются только неудачи, поэтому офис за одним NAT не блокирует сам себя.
# По умолчанию — RATE_LIMIT_MAX_ATTEMPTS * 5.
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_MAX_FAILED_PER_IP=50

# Ставить ли флаг Secure на auth-cookie. По умолчанию включено в release-сборке
# и выключено в debug. Выключать в проде значит разрешить браузеру отправить
# cookie по обычному http.
AUTH_COOKIE_SECURE=true

# Доверять ли заголовкам X-Forwarded-For / X-Real-IP при определении IP клиента.
# Включать ТОЛЬКО если перед сервером действительно стоит доверенный обратный
# прокси, который эти заголовки перезаписывает: иначе клиент сам выбирает себе
# корзину rate limit и обходит оба бюджета выше.
TRUSTED_PROXY_MODE=true

# Размер буфера WebSocket-канала на пользователя (bounded channel).
# При переполнении новые сообщения отбрасываются с предупреждением.
WS_CHANNEL_CAPACITY=64

# Уровень логирования (tracing).
# Варианты: error, warn, info, debug, trace
RUST_LOG=zali_server=info,tower_http=warn

# Web Push (VAPID) для браузерного/PWA клиента — доставка уведомлений, когда
# вкладка/PWA полностью закрыта (не нужно для macOS/Windows/iOS/Android — у них
# своя локальная SHOW_NOTIFICATION). Если пусто — фича отключена:
# /api/push/vapid-public-key вернёт 404, клиент не будет подписываться.
# Сгенерировать новую пару: cargo run --manifest-path server/Cargo.toml --example gen_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zalikus.org

# Ключ шифрования .zali-экспортов hash chain переписок
# (GET /api/conversations/hash-chain.zali, файлы в <ZALI_DATA_DIR>/hash_chains/).
# В отличие от остальных опциональных настроек, «пусто» здесь НЕ отключает фичу:
# цепочка пишется всегда, поэтому при пустом значении ключ детерминированно
# выводится из JWT_SECRET (SHA-256, односторонне). Задавайте явно, если экспорты
# должны переживать ротацию JWT_SECRET — иначе после ротации старые файлы уже
# не открыть. Сгенерировать: openssl rand -hex 32
HASH_CHAIN_KEY=

# Токен для публикации релизов macOS/Windows-клиента (POST /api/version).
# Если пусто — POST /api/version всегда 403, фича автообновления отключена.
# GET /api/version (проверка обновлений клиентами) публичный и не требует токена.
RELEASE_ADMIN_TOKEN=
