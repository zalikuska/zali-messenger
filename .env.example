# ================================================================
# ZaliMessenger Server — Конфигурация окружения
# Скопируйте в .env и заполните перед запуском в продакшене
# ================================================================

# В Docker секреты (JWT_SECRET, RELEASE_ADMIN_TOKEN) лежат в ./secrets/, а не здесь:
# scripts/docker_init_secrets.sh. Всё, что записано в .env, видно в `docker inspect`.
#
# ОБЯЗАТЕЛЬНО в продакшене: секретный ключ для подписи JWT-токенов.
# Должен быть не менее 32 символов и случайным (заглушки и повторы релизный
# бинарник не принимает). Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Разрешённые CORS-источники (через запятую).
# В продакшене укажите только ваши домены — этот список работает вместе с
# allow_credentials(true), то есть каждый источник отсюда может ходить в API
# с cookie пользователя и читать ответы.
#
# НЕ добавляйте сюда `null`: это origin песочничного iframe, `data:`- и
# `file:`-документов, то есть ровно того, что подставляет чужая страница.
# Раньше он стоял в этом примере; сервер теперь выбрасывает его сам и пишет
# предупреждение в лог, но и в конфиге ему не место.
#
# localhost-источники нужны только для локальной разработки — в проде они
# означают, что любая страница, отданная с localhost:80/3000 (чужой dev-сервер,
# локально запущенный зловред), получает полный доступ к API от имени
# залогиненного пользователя.
ALLOWED_ORIGINS=https://msgs.zalikus.org,zali://localhost

# Максимальный размер загружаемого файла в байтах (по умолчанию 10MB).
MAX_UPLOAD_BYTES=10485760

# Гостевой режим: КАЖДЫЙ запрос без токена выполняется от имени пользователя
# "Zalikus". Это не «упрощённый вход», а полное отключение аутентификации:
# читать переписку, отправлять сообщения и менять настройки этого аккаунта
# сможет кто угодно, кто знает адрес сервера.
#
# Оставлено только для локальной отладки старых сборок. В любом развёрнутом
# сервере — false. Раньше здесь по умолчанию стояло true, то есть скопированный
# как есть пример открывал аккаунт наружу; сервер теперь пишет в лог отдельное
# предупреждение при каждом старте с включённым режимом.
ALLOW_GUEST_MODE=false

# Rate limiting для /api/auth/login — два независимых бюджета.
#
# RATE_LIMIT_MAX_ATTEMPTS — попыток на пару (логин, IP) за окно. Тормозит подбор
# пароля к одному аккаунту.
#
# RATE_LIMIT_MAX_FAILED_PER_IP — НЕУДАЧНЫХ входов с одного IP за окно, по всем
# логинам сразу. Без него подбор одного пароля по списку логинов (password spray)
# не ограничен ничем: каждая попытка попадает в свой бюджет по первому ключу, а
# список аккаунтов и так отдаётся любому залогиненному через /api/users.
# Считаются только неудачи, поэтому офис за одним NAT не блокирует сам себя.
# По умолчанию — RATE_LIMIT_MAX_ATTEMPTS * 5.
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_MAX_FAILED_PER_IP=50

# Ставить ли флаг Secure на auth-cookie. По умолчанию включено в release-сборке
# и выключено в debug. Выключать в проде значит разрешить браузеру отправить
# cookie по обычному http.
AUTH_COOKIE_SECURE=true

# Доверять ли заголовкам X-Forwarded-For / X-Real-IP при определении IP клиента.
# Включать ТОЛЬКО если перед сервером действительно стоит доверенный обратный
# прокси, который эти заголовки перезаписывает: иначе клиент сам выбирает себе
# корзину rate limit и обходит оба бюджета выше.
TRUSTED_PROXY_MODE=true

# Подсети (через запятую), с которых приходит ваш обратный прокси, помимо
# loopback. Нужно в Docker: nginx на хосте подключается к контейнеру с адреса
# шлюза сети compose, а не с 127.0.0.1, и без этого X-Real-IP игнорируется —
# все клиенты попадают в одну корзину rate limit. Пусто (по умолчанию) —
# доверяется только loopback. Указывайте как можно уже: любой адрес из списка
# может подставить клиентский IP. docker-compose.yml задаёт это сам
# (172.29.77.0/24); при запуске без Docker переменную не трогайте.
TRUSTED_PROXY_CIDRS=

# Размер буфера WebSocket-канала на пользователя (bounded channel).
# При переполнении новые сообщения отбрасываются с предупреждением.
WS_CHANNEL_CAPACITY=64

# Уровень логирования (tracing).
# Варианты: error, warn, info, debug, trace
RUST_LOG=zali_server=info,tower_http=warn

# Web Push (VAPID) для браузерного/PWA клиента — доставка уведомлений, когда
# вкладка/PWA полностью закрыта (не нужно для macOS/Windows/iOS/Android — у них
# своя локальная SHOW_NOTIFICATION). Если пусто — фича отключена:
# /api/push/vapid-public-key вернёт 404, клиент не будет подписываться.
# Сгенерировать новую пару: cargo run --manifest-path server/Cargo.toml --example gen_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zalikus.org

# Firebase Cloud Messaging для нативного Android-приложения (server/src/fcm.rs):
# путь к JSON-ключу сервисного аккаунта Firebase («Project settings → Service
# accounts → Generate new private key»). Файл — секрет: права 600, вне репозитория.
# Пусто — FCM отключён: /api/push/fcm/register вернёт 404, пуши на Android не уходят.
FCM_SERVICE_ACCOUNT_FILE=

# Ключ шифрования .zali-экспортов hash chain переписок
# (GET /api/conversations/hash-chain.zali, файлы в <ZALI_DATA_DIR>/hash_chains/).
# В отличие от остальных опциональных настроек, «пусто» здесь НЕ отключает фичу:
# цепочка пишется всегда, поэтому при пустом значении ключ детерминированно
# выводится из JWT_SECRET (SHA-256, односторонне). Задавайте явно, если экспорты
# должны переживать ротацию JWT_SECRET — иначе после ротации старые файлы уже
# не открыть. Сгенерировать: openssl rand -hex 32
HASH_CHAIN_KEY=

# Токен для публикации релизов macOS/Windows-клиента (POST /api/version).
# Если пусто — POST /api/version всегда 403, фича автообновления отключена.
# GET /api/version (проверка обновлений клиентами) публичный и не требует токена.
RELEASE_ADMIN_TOKEN=

# Временные TURN-креды (RFC 5766 «TURN REST API», режим coturn use-auth-secret).
# Пусто (по умолчанию) — GET /api/voice/turn-credentials отвечает 404, и клиент
# использует статическую пару zali/turnpass, вшитую в бандл. Эта пара лежит
# внутри каждого клиента: релеем может пользоваться любой, кто открывал сборку,
# и отозвать её можно только пересборкой всех клиентов на всех платформах.
#
# ВАЖНО: задавайте TURN_STATIC_AUTH_SECRET только после того, как тот же секрет
# прописан в coturn как static-auth-secret вместе с use-auth-secret. Иначе релей
# отвергнет выданные здесь креды, и это будет выглядеть как полностью сломанный
# TURN — то есть как звонки, не проходящие через NAT.
# Сгенерировать: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
# Через запятую; отдаются клиенту вместе с кредами. Пустой список выключает
# выдачу целиком (креды без адресов бесполезны).
TURN_URLS=turn:msgs.zalikus.org:3478?transport=udp,turn:msgs.zalikus.org:3478?transport=tcp,turns:msgs.zalikus.org:5349?transport=tcp,turns:msgs.zalikus.org:443?transport=tcp
# Время жизни креда, секунды (минимум 300, по умолчанию 43200 — 12 часов:
# заведомо дольше любого звонка и заметно короче «навсегда»).
TURN_CREDENTIAL_TTL_SECS=43200

# --- SFU: видео звонков через сервер (server/src/sfu.rs) ---
# Не задан SFU_UDP_PORT — SFU выключен, видео идёт в mesh (по копии каждому собеседнику).
# Задан — камера/экран отправителя уходят на сервер ОДНИМ потоком (simulcast), сервер
# раздаёт каждому зрителю слой под его канал. Порт нужно открыть наружу по UDP и по TCP:
# TCP (тот же номер) — запасной путь для сетей, где UDP закрыт (ICE-TCP).
# Включайте ВМЕСТЕ с SFU_PUBLIC_IP: в Docker без него сервер объявит клиентам адрес
# контейнера, и каждый звонок с видео будет 12 с ждать SFU, а потом уходить в mesh.
# SFU_UDP_PORT=3479
# Публичный адрес сервера, который он объявляет клиентам. Без него берётся адрес
# исходящего интерфейса — за NAT/в Docker/на хосте с VPN это не тот адрес: задайте явно.
# SFU_PUBLIC_IP=203.0.113.10
# На каком локальном адресе занять UDP-порт (по умолчанию 0.0.0.0).
# SFU_BIND_IP=
# Linux: поднимите потолок буферов сокетов, иначе ключевые кадры 4K теряют хвост в ядре:
#   sysctl -w net.core.rmem_max=16777216 net.core.wmem_max=16777216

# --- SSH-вход в Docker (сервис zali-ssh поднимается вместе с сервером) ---
# Основной ключ контейнер создаёт сам, приватную часть отдаёт один раз:
#   http://<адрес-хоста>:2223/ → «Скачать ключ» (пароль ключа = RELEASE_ADMIN_TOKEN)
# Дополнительные публичные ключи подтягиваются автоматически и обновляются по таймеру.
# Логины GitHub через запятую → https://github.com/<логин>.keys
SSH_KEYS_GITHUB=
# Свои https-URL со списком ключей (через запятую)
SSH_KEYS_URLS=
# Период обновления ключей, секунд (0 — только при старте)
SSH_KEYS_REFRESH=600
# Порты и адреса на хосте. По умолчанию открыты наружу (0.0.0.0): ограничьте файрволом
# или поставьте 127.0.0.1 (тогда только с самой машины / через ssh -J).
# ZALI_SSH_PORT=2222
# ZALI_SSH_BIND=0.0.0.0
# Порт выдачи ключа (ключ в файле зашифрован паролем, см. docs/DOCKER.md)
# ZALI_SSH_KEY_PORT=2223
# ZALI_SSH_KEY_BIND=0.0.0.0
# rw (по умолчанию) или ro — доступ сессии к данным сервера
# ZALI_SSH_DATA_MODE=rw

# ── Жалобы на сообщения и автомодерация (server/src/moderation.rs, docs/MODERATION.md) ──
# Ключ OpenRouter для классификатора Jev. Пусто — жалобы принимаются и копятся в
# очереди, классификатор не зовётся (разберутся, когда ключ появится).
OPENROUTER_API_KEY=
# Модель Decisions API. Версия закреплена: пороги решения подобраны под её вероятности.
# MODERATION_MODEL=typesafe/jev-1.14
# Свой счётчик запросов к OpenRouter — с запасом ниже бесплатного тира
# (20 в минуту, 50 в сутки, пока куплено меньше $10). Сутки — по UTC.
# MODERATION_MAX_PER_MINUTE=10
# MODERATION_MAX_PER_DAY=40
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# ── Выбор GIF в поле ввода (server/src/gifs.rs) ──
# Ключ приложения KLIPY (partner.klipy.com → API Keys). Сервер только отдаёт его
# вошедшим клиентам, поиск и картинки клиент берёт у KLIPY сам. Пусто — кнопки GIF нет.
KLIPY_APP_KEY=

# ── Почта: привязка почты к аккаунту и сброс пароля (server/src/mailer.rs, docs/MAIL.md) ──
# direct — сервер сам доставляет письма на MX получателей (нужны DNS SPF/DKIM/DMARC,
#          PTR адреса и открытый исходящий 25-й порт у хостера);
# smtp   — через SMTP-relay (свой Postfix или провайдер почты);
# file   — письма в каталог (по умолчанию в debug-сборке, для разработки);
# off    — почта выключена (по умолчанию в релизе): поля почты и «Забыли пароль?» не видны.
# MAIL_TRANSPORT=direct
# Отправитель. Домен — тот, для которого настроены SPF/DKIM/DMARC.
# MAIL_FROM=ZaliMessenger <no-reply@example.org>
# Имя в EHLO (по умолчанию домен из MAIL_FROM). Должно совпадать с PTR адреса сервера.
# MAIL_HELO_NAME=mail.example.org
# DKIM: ключ — `zali_server mail dkim-keygen --selector zali --out /etc/zali/dkim.pem`
# DKIM_SELECTOR=zali
# DKIM_PRIVATE_KEY_FILE=/etc/zali/dkim.pem
# DKIM_DOMAIN=example.org
# Relay (MAIL_TRANSPORT=smtp). SMTP_SECURITY: starttls (587, по умолчанию) | tls (465) |
# none (только relay на loopback — иначе логин ушёл бы открытым текстом).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/etc/zali/smtp-password
# Каталог для MAIL_TRANSPORT=file (по умолчанию <ZALI_DATA_DIR>/mail-outbox).
# MAIL_OUTBOX_DIR=

# --- Очистка устаревших вложений при нехватке места (server/src/attachment_gc.rs) ---
# off (по умолчанию) | dry (только пишет в журнал, что удалил бы) | on (удаляет).
# Сообщение шифруется целиком, поэтому удаляется сообщение вместе с текстом, а не одно вложение.
# Включайте через dry: сначала посмотрите в журнале строки "[GC][dry]".
# ZALI_ATTACHMENT_GC=off
# Чистить, когда на разделе uploads/ свободно меньше (байт), и до тех пор, пока не станет больше целевого.
# ZALI_UPLOADS_MIN_FREE_BYTES=2147483648
# ZALI_UPLOADS_TARGET_FREE_BYTES=3221225472
# Потолок размера uploads/ (0 — не ограничивать); при превышении чистим до 85 %.
# ZALI_UPLOADS_QUOTA_BYTES=0
# Не трогать сообщения моложе N дней, файлы меньше N байт (текст ~300 Б) и последние N сообщений беседы.
# ZALI_ATTACHMENT_MIN_AGE_DAYS=30
# ZALI_ATTACHMENT_MIN_BYTES=262144
# ZALI_ATTACHMENT_KEEP_RECENT=50
# Не больше N сообщений и N секунд за один запуск.
# ZALI_ATTACHMENT_MAX_PER_RUN=500
# ZALI_ATTACHMENT_BUDGET_SECS=60
# Старые файлы релизов в releases/ (чистятся первыми и только под давлением места): версионный файл,
# на который уже не ссылается ни один релиз, уходит через N дней. Опубликованные релизы и файлы без версии
# в имени (ZaliMessengerOnlineSetup.exe) не трогаются никогда.
# ZALI_RELEASES_KEEP_DAYS=14
