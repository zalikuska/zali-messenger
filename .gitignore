# Rust build artifacts
/target/
**/target/
/.build/
**/.build/

# OS/editor noise
.DS_Store
.idea/
.vscode/
.obsidian/

# graphify knowledge-graph cache (regenerate with `graphify update .`)
graphify-out/

# Local env and runtime data
.env
*.env.local
zali_messenger.db
*.db-shm
*.db-wal
uploads/
server.log
*.log

# Generated archives and bundles
*.zip
*.exe
*.app
dist/

# macOS build artifacts
apps/macos/ZaliMessenger/Frameworks/*.a
DerivedData/
*.xcuserdata/
zali-windows-source/

# iOS: generated by xcodegen / build_ios_core.sh — regenerate, don't commit
apps/ios/ZaliMessenger.xcodeproj/
apps/ios/Frameworks/*.xcframework

# Android: generated by Gradle / apps/android/build_android_core.sh.
# assets/web/ — вывод scripts/bundle_web.py (build_android_core.sh собирает
# только Rust-ядро и веб-ассетов не касается). До 2026-08-18 их не создавал
# никто: они копировались руками и отстали на две недели.
apps/android/build/
apps/android/app/build/
apps/android/app/src/main/assets/web/
apps/android/app/src/main/jniLibs/
apps/android/.gradle/
apps/android/local.properties
# Firebase-конфиг Android (FCM) — у того, кто собирает APK; в публичный репозиторий не кладётся.
apps/android/app/google-services.json
tests/voice_e2e/node_modules/

# Runtime data (server-generated uploads/avatars), not source
/assets/

# Инфраструктура прода — репозиторий публичный, держать только локально
CLAUDE.local.md
ops/

# Приватные ops-скиллы (инфраструктура прода; репозиторий публичный)
.claude/skills/zali-ops-*/

# Вывод scripts/bundle_web.py. Источник правды — web/src/, web/index.html,
# web/style.css, web/bridge_protocol.json; всё ниже собирается из них и раздувало
# каждый коммит на мегабайты (Assets.swift и Resources/Web/app.js — по ~2,5 МБ,
# web/app.js — столько же). Все сборочные скрипты запускают bundle_web.py сами;
# на свежем клоне: `python3 scripts/bundle_web.py`.
# BridgeProtocol.generated.swift и web/src/modules/native_types.js остаются в git:
# они крошечные, а первый читают doctor-проверки и bridge_check.sh.
/web/app.js
/apps/macos/Sources/ZaliMessenger/Assets.swift
/apps/macos/Sources/ZaliMessenger/Resources/Web/*
# Папка нужна SwiftPM (Package.swift: .copy("Resources/Web")) ещё до первой сборки
# бандла, поэтому в git лежит только заглушка.
!/apps/macos/Sources/ZaliMessenger/Resources/Web/.gitkeep
