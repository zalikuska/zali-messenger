# sshd для контейнера zali-ssh (запускается без root, см. server/Dockerfile.ssh).
# Только вход по ключу; публичные ключи кладёт ssh-entrypoint.sh.

Port 2222
ListenAddress 0.0.0.0
HostKey /hostkeys/ssh_host_ed25519_key
PidFile /tmp/sshd.pid

# authorized_keys лежит в tmpfs и пересобирается entrypoint'ом — не в домашнем
# каталоге (там том с данными сервера). Права на файл проверяет сам entrypoint.
AuthorizedKeysFile /tmp/ssh/authorized_keys
StrictModes no

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
UsePAM no
AllowUsers zali

# Только шелл и sftp: никаких пробросов, агента, X11 и туннелей.
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
Subsystem sftp internal-sftp

LoginGraceTime 20
MaxAuthTries 3
MaxStartups 5:50:10
ClientAliveInterval 60
ClientAliveCountMax 3
PrintMotd no
LogLevel INFO
